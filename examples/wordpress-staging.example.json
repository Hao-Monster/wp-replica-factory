{
  "environment": "staging",
  "production": false,
  "siteUrl": "http://127.0.0.1:8080",
  "transport": "ssh",
  "ssh": {"host": "staging.example.invalid", "user": "deploy"},
  "runtime": {
    "type": "docker-compose-wordpress",
    "composePath": "/opt/example/wordpress",
    "service": "wordpress",
    "hostWpPath": "/opt/example/wordpress/data",
    "containerWpPath": "/var/www/html"
  },
  "policy": {"allowDevelopment": false, "activate": true},
  "themeSlug": "replica-woocommerce",
  "fixtureMarker": "replica-fixture",
  "healthPaths": ["/", "/shop/"]
}
